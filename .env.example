# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=synaptiq
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=synaptiqbi
DATABASE_URL=postgresql+asyncpg://synaptiq:changeme_in_prod@postgres:5432/synaptiqbi

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── AI (Phase 4) ────────────────────────────────────────────
# Leave empty to use rule-based fallback (no OpenAI account needed)
OPENAI_API_KEY=sk-...

# ─── n8n / Automation (Phase 5) ──────────────────────────────
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_API_KEY=changeme_n8n_key

# ─── Power BI Embedded (Phase 6) ────────────────────────────
# Requires Azure App Registration with Power BI API permissions
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
